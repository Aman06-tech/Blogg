# MongoDB Connection String
# Get from MongoDB Atlas: https://cloud.mongodb.com/
MONGO=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Secrets (Generate strong random strings)
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_strong_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_32_characters_strong_random_string

# SMTP Email Configuration (for sending verification/reset emails)
# Use Gmail, SendGrid, or any SMTP provider
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Environment
NODE_ENV=development

# URLs
BASE_URL=http://localhost:6789
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK Configuration (Optional - for Firebase features)
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_here\n-----END PRIVATE KEY-----\n"

# Server Port (Optional - defaults to 6789)
PORT=6789
